{
  "name": "newsgwcbroker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:content",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "dev:sandbox": "NEWS_CONTENT_DIR=.sandbox/news NEWS_IMAGES_PATH=news-images-sandbox next dev",
    "build:sandbox": "NEWS_CONTENT_DIR=.sandbox/news NEWS_IMAGES_PATH=news-images-sandbox npm run build",
    "sandbox:seed": "node scripts/sandbox.mjs seed",
    "sandbox:publish": "node scripts/sandbox.mjs publish",
    "sandbox:list": "node scripts/sandbox.mjs list",
    "sandbox:clear": "node scripts/sandbox.mjs clear",
    "news:image": "node scripts/prepare-image.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
